# Field Theory CLI — Environment Variables
# Copy this file to .env.local and fill in values as needed.
# NEVER commit .env or .env.local to version control.

# ── Data Directory ──────────────────────────────────────────────────────
# Override the default data directory (~/.ft-bookmarks/)
# FT_DATA_DIR=/path/to/custom/dir

# ── Browser Selection ──────────────────────────────────────────────────
# Which browser to extract session cookies from: chrome|helium|brave|arc|firefox
# FT_BROWSER=chrome

# ── Browser Profile (Advanced) ─────────────────────────────────────────
# Custom browser user-data directory (auto-detected by default)
# FT_CHROME_USER_DATA_DIR=/path/to/browser/User Data

# Custom browser profile name (Default by default)
# FT_CHROME_PROFILE_DIRECTORY=Default

# ── X/Twitter OAuth API ───────────────────────────────────────────────
# Required for `ft auth` and `ft sync --api` (cross-platform sync)
# Not needed for default GraphQL sync which uses browser cookies.
# X_API_KEY=
# X_API_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# OAuth callback URL (default: http://127.0.0.1:3000/callback)
# X_CALLBACK_URL=http://127.0.0.1:3000/callback